<?xml version="1.0" encoding="utf-8"?>
<!-- Backup exclusions for Android 11 (API 30) and lower. -->
<full-backup-content>
    <!-- EncryptedSharedPreferences cannot be restored without its Keystore key. -->
    <exclude domain="sharedpref" path="saved_accounts_encrypted.xml" />
    <exclude domain="sharedpref" path="twocaptcha_key_encrypted.xml" />
    <exclude domain="sharedpref" path="delete_task_secrets_encrypted.xml" />
    <exclude domain="sharedpref" path="proxy_cleaner_encrypted.xml" />
</full-backup-content>
